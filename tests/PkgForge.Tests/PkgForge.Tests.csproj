<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PkgForge.Tests</RootNamespace>
    <AssemblyName>PkgForge.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PkgForge.Core\PkgForge.Core.csproj" />
    <!-- Build-order dependency only; E2E launches the produced executable. -->
    <ProjectReference Include="..\..\src\PkgForge.Cli\PkgForge.Cli.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Canonical shard definitions are vendored under schemas/ so the source tree
      builds without an external sibling repository.
    -->
    <EmbeddedResource Include="$(RelaySchemaRoot)\schema-catalog.sql"
                      LogicalName="PkgForge.Tests.Schema.catalog.sql"
                      Link="ReusedSchema\schema-catalog.sql" />
    <EmbeddedResource Include="$(RelaySchemaRoot)\schema-launch.sql"
                      LogicalName="PkgForge.Tests.Schema.launch.sql"
                      Link="ReusedSchema\schema-launch.sql" />
    <EmbeddedResource Include="$(RelaySchemaRoot)\schema-assets.sql"
                      LogicalName="PkgForge.Tests.Schema.assets.sql"
                      Link="ReusedSchema\schema-assets.sql" />
  </ItemGroup>
</Project>
